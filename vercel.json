{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/product/t-shirt-essential/",
      "destination": "/collection/",
      "permanent": true
    },
    {
      "source": "/product/chemise-premium/",
      "destination": "/collection/",
      "permanent": true
    },
    {
      "source": "/product/polo-minimal/",
      "destination": "/collection/",
      "permanent": true
    },
    {
      "source": "/produit/1/",
      "destination": "/collection/",
      "permanent": true
    },
    {
      "source": "/produit/2/",
      "destination": "/collection/",
      "permanent": true
    },
    {
      "source": "/produit/3/",
      "destination": "/collection/",
      "permanent": true
    },
    {
      "source": "/produit/4/",
      "destination": "/collection/",
      "permanent": true
    },
    {
      "source": "/produit/5/",
      "destination": "/collection/",
      "permanent": true
    }
  ]
}
